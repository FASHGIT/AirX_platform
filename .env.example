# Public Supabase configuration only. These publishable values are safe for
# browser use only because database grants and RLS protect access; test RLS on a non-production database before preview use.
# Never add a service-role, secret, database password or provider credential.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility if the project still uses an anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use a branch-scoped Preview URL. Do not point Preview Auth callbacks at Production.
NEXT_PUBLIC_SITE_URL=


